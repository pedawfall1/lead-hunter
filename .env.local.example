# ---------------------------------------------------------------------------
# Sem estas duas variaveis o app sobe em MODO DEMO: dados ficticios na memoria,
# login com qualquer email, nenhuma chamada externa. Bom pra ver a interface.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Force o modo demo mesmo com o Supabase configurado:
# NEXT_PUBLIC_DEMO=1

# ---------------------------------------------------------------------------
# Integração com n8n (opcional). Sem N8N_WEBHOOK_URL o botão de disparo
# automático nem aparece, e o app segue funcionando com o link wa.me.
# Nenhuma destas tem NEXT_PUBLIC_: são segredos e ficam só no servidor.
# ---------------------------------------------------------------------------

# Webhook do seu fluxo n8n que recebe o disparo e manda pela Evolution
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/lead-hunter

# Enviado no header x-lh-token quando o Lead Hunter chama o n8n
N8N_TOKEN=

# Exigido no header x-lh-token quando o n8n chama /api/n8n de volta
LH_WEBHOOK_TOKEN=

# Supabase -> Project Settings -> API -> service_role. SECRETA.
# Só o webhook usa: ele chega sem sessão e precisa gravar pelo dono do lead.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Apify: busca no Google Maps, chamada direto pelo servidor do app.
# Sem APIFY_TOKEN o botao "Buscar no Google Maps" fica desabilitado.
# ---------------------------------------------------------------------------
APIFY_TOKEN=apify_api_...

# Actor a usar. O padrao e o scraper de Google Maps mais comum.
# APIFY_ACTOR=compass~crawler-google-places

# ---------------------------------------------------------------------------
# OpenAI: gera o conteudo da demo de site do lead.
# Sem OPENAI_API_KEY o botao "Gerar demo" fica desabilitado e sobra o
# caminho manual (copiar o prompt e colar no v0/Lovable), que nao custa nada.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# A LLM escreve ~1.500 tokens de TEXTO, nao o HTML: quem monta a pagina e
# src/lib/site/render.ts. Por isso um modelo da classe barata basta e a
# conta fica em milesimos de dolar por demo. Confira o nome exato do modelo
# no painel da OpenAI — nome de modelo muda de temporada.
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Pexels: as fotos da demo. Gratuito — pegue em pexels.com/api.
# Sem esta chave a demo renderiza com gradiente e tipografia, sem quebrar.
# As URLs do CDN do Pexels sao estaveis, entao a pagina aponta direto pra
# elas: nada e baixado nem guardado.
# ---------------------------------------------------------------------------
PEXELS_API_KEY=

# Actor de perfil do Instagram. Usa o mesmo APIFY_TOKEN do Google Maps.
# APIFY_ACTOR_IG=apify~instagram-profile-scraper
